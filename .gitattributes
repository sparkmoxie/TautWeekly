* text=auto
.gitattributes text eol=lf

*.ps1 text eol=lf
*.psm1 text eol=lf
*.sh text eol=lf
*.command text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.py text eol=lf
*.bat text eol=crlf

*.gif binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.gz binary

# Canonical and vendor-supplied artwork is validated byte-for-byte. Keep SVG
# source bytes unchanged across Windows and Unix checkouts.
/assets/branding/*.svg binary
/assets/branding/build-assets.py binary
/assets/platforms/*.svg binary
/docs/assets/platforms/*.svg binary
