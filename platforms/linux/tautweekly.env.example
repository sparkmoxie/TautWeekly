# Native Linux service environment. This file contains no SMTP or API secrets.
TZ=Etc/UTC
TAUTWEEKLY_APP_DIR=/opt/tautweekly
TAUTWEEKLY_DATA_DIR=/var/lib/tautweekly
TAUTWEEKLY_CONFIG=/var/lib/tautweekly/config.json
TAUTWEEKLY_PREVIEW_BIND=127.0.0.1
TAUTWEEKLY_PREVIEW_LISTEN_PORT=8787
TAUTWEEKLY_PREVIEW_BASE_URL=http://127.0.0.1:8787
