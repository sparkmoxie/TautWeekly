#!/usr/bin/env bash
set -euo pipefail

env_file="${TAUTWEEKLY_ENV_FILE:-/etc/tautweekly/tautweekly.env}"
if [[ -r "$env_file" ]]; then
  set -a
  # shellcheck source=/dev/null
  source "$env_file"
  set +a
fi

app_root="${TAUTWEEKLY_APP_DIR:-/opt/tautweekly}"
data_root="${TAUTWEEKLY_DATA_DIR:-/var/lib/tautweekly}"
service_user="${TAUTWEEKLY_SERVICE_USER:-tautweekly}"
export TAUTWEEKLY_APP_DIR="$app_root"
export TAUTWEEKLY_DATA_DIR="$data_root"
export TAUTWEEKLY_CONFIG="${TAUTWEEKLY_CONFIG:-$data_root/config.json}"

require_root() {
  if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    echo "Run this command with sudo so it can use the protected TautWeekly service account and data directory." >&2
    exit 77
  fi
}

run_as_service_user() {
  require_root
  runuser -u "$service_user" -- env \
    TZ="${TZ:-Etc/UTC}" \
    TAUTWEEKLY_APP_DIR="$app_root" \
    TAUTWEEKLY_DATA_DIR="$data_root" \
    TAUTWEEKLY_CONFIG="$TAUTWEEKLY_CONFIG" \
    TAUTWEEKLY_PREVIEW_BASE_URL="${TAUTWEEKLY_PREVIEW_BASE_URL:-}" \
    "$@"
}

run_ps() {
  local script="$1"
  shift
  run_as_service_user pwsh -NoLogo -NoProfile -File "$app_root/$script" "$@"
}

run_mode() {
  run_as_service_user "$app_root/bin/run-mode.sh" "$@"
}

prompt_user() {
  local value="${1:-}"
  if [[ -z "$value" ]]; then
    read -r -p "UserId, username, friendly name, or email: " value
  fi
  [[ -n "$value" ]] || { echo "A user identifier is required." >&2; exit 64; }
  printf '%s' "$value"
}

confirm() {
  local prompt="$1" answer
  read -r -p "$prompt [y/N]: " answer
  [[ "$answer" =~ ^[Yy]([Ee][Ss])?$ ]]
}

cmd="${1:-help}"
shift || true
case "$cmd" in
  setup)
    require_root
    systemctl stop tautweekly.service 2>/dev/null || true
    run_ps Setup-First.ps1 -DataRoot "$data_root"
    systemctl start tautweekly.service
    ;;
  verify) run_ps Verify-Setup.ps1 -DataRoot "$data_root" ;;
  cache-status) run_ps Cache-Diagnostics.ps1 -DataRoot "$data_root" "$@" ;;
  cache-refresh) run_mode CacheWarm ;;
  list-users) run_mode ListUsers ;;
  exclude-users|manage-exclusions) run_ps Manage-User-Exclusions.ps1 -ConfigPath "$TAUTWEEKLY_CONFIG" ;;
  list-libraries) run_ps Manage-Library-Selection.ps1 -ConfigPath "$TAUTWEEKLY_CONFIG" -ListOnly ;;
  libraries|manage-libraries) run_ps Manage-Library-Selection.ps1 -ConfigPath "$TAUTWEEKLY_CONFIG" ;;
  preview)
    user="$(prompt_user "${1:-}")"
    run_mode Preview "$user"
    ;;
  preview-all)
    user="$(prompt_user "${1:-}")"
    run_mode PreviewAll "$user"
    ;;
  send-test)
    user="$(prompt_user "${1:-}")"
    confirm "Send one test email to TestEmail using $user?" || exit 0
    run_mode SendTest "$user"
    ;;
  send-test-all)
    user="$(prompt_user "${1:-}")"
    confirm "Send all six regression emails to TestEmail using $user?" || exit 0
    run_mode SendTestAll "$user"
    ;;
  welcome)
    user="$(prompt_user "${1:-}")"
    confirm "Send the real one-off welcome to the selected Plex user's email?" || exit 0
    run_mode SendWelcome "$user" --confirm-welcome
    ;;
  send-all)
    echo "WARNING: This sends one real newsletter to every eligible Plex user."
    confirm "Have you reviewed a current TestEmail and do you want to continue?" || exit 0
    run_mode SendAll --confirm-send-all
    ;;
  roster) run_ps View-Access-Roster.ps1 -DataRoot "$data_root" ;;
  repair-assets) run_ps Repair-Assets.ps1 -DataRoot "$data_root" ;;
  schedule-status) run_ps Schedule-Control.ps1 -Action Status -DataRoot "$data_root" ;;
  schedule-enable)
    confirm "Enable the configured automatic weekly send?" || exit 0
    run_ps Schedule-Control.ps1 -Action Enable -DataRoot "$data_root"
    ;;
  schedule-disable) run_ps Schedule-Control.ps1 -Action Disable -DataRoot "$data_root" ;;
  schedule-reset)
    echo "This clears today's automatic-attempt guard. A later scheduler poll may send again today."
    confirm "Clear the guard?" || exit 0
    run_ps Schedule-Control.ps1 -Action ResetToday -DataRoot "$data_root"
    ;;
  manager-bootstrap)
    run_as_service_user "$app_root/bin/tautweekly-manager" access-bootstrap --data-dir "$data_root/manager"
    ;;
  manager-reset-access)
    require_root
    was_active=false
    if systemctl is-active --quiet tautweekly.service; then
      systemctl stop tautweekly.service
      was_active=true
    fi
    if ! run_as_service_user "$app_root/bin/tautweekly-manager" access-recover --data-dir "$data_root/manager" --confirm; then
      $was_active && systemctl start tautweekly.service
      exit 1
    fi
    systemctl start tautweekly.service
    echo "Run sudo tautweekly manager-bootstrap to retrieve the new one-time pairing token."
    ;;
  remote-access-authorize)
    require_root
    tailscale_cli=""
    for candidate in /usr/bin/tailscale /usr/local/bin/tailscale; do
      if [[ -f "$candidate" && ! -L "$candidate" ]]; then
        tailscale_cli="$candidate"
        break
      fi
    done
    if [[ -z "$tailscale_cli" ]]; then
      echo "Install the official Tailscale Linux package and sign this host into your tailnet first." >&2
      exit 69
    fi
    backend_state="$($tailscale_cli status --json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("BackendState", ""))' 2>/dev/null || true)"
    if [[ "$backend_state" != "Running" ]]; then
      echo "Tailscale is installed but not connected. Run sudo tailscale up, finish sign-in, and retry." >&2
      exit 69
    fi
    install -m 0644 -o root -g root /dev/null /etc/tautweekly/remote-access.enabled
    systemctl enable --now tautweekly-remote-access.socket >/dev/null
    systemctl is-active --quiet tautweekly-remote-access.socket || {
      echo "The fixed TautWeekly remote-access adapter socket did not start." >&2
      exit 70
    }
    echo "Authorized TautWeekly's fixed Inspect/Enable/Disable Tailscale adapter."
    echo "The Manager remains the unprivileged tautweekly service user; Funnel remains unsupported."
    ;;
  remote-access-revoke)
    require_root
    remote_state="$data_root/manager/remote-access.json"
    if [[ -f "$remote_state" ]]; then
      remote_enabled="$(python3 -c 'import json,sys; print("true" if json.load(open(sys.argv[1], encoding="utf-8")).get("enabled") is True else "false")' "$remote_state" 2>/dev/null || echo invalid)"
      if [[ "$remote_enabled" != "false" ]]; then
        echo "Disable private access in Manager before revoking the host adapter so the owned Serve route is removed safely." >&2
        exit 75
      fi
    fi
    systemctl disable --now tautweekly-remote-access.socket >/dev/null 2>&1 || true
    rm -f /etc/tautweekly/remote-access.enabled
    echo "Revoked the optional TautWeekly Tailscale adapter."
    ;;
  remote-access-status)
    if [[ -f /etc/tautweekly/remote-access.enabled ]] && systemctl is-active --quiet tautweekly-remote-access.socket 2>/dev/null; then
      echo "TautWeekly Tailscale adapter: authorized"
    else
      echo "TautWeekly Tailscale adapter: not authorized"
    fi
    ;;
  start|stop|restart|status)
    require_root
    systemctl "$cmd" tautweekly.service
    ;;
  logs)
    require_root
    journalctl -u tautweekly.service -n 200 -f
    ;;
  backup)
    require_root
    stamp="$(date +%Y%m%d-%H%M%S)"
    archive="${PWD}/tautweekly-private-data-$stamp.tar.gz"
    was_active=false
    if systemctl is-active --quiet tautweekly.service; then
      systemctl stop tautweekly.service
      was_active=true
    fi
    if ! tar -czf "$archive" -C "$(dirname "$data_root")" "$(basename "$data_root")"; then
      $was_active && systemctl start tautweekly.service
      exit 1
    fi
    chmod 600 "$archive"
    $was_active && systemctl start tautweekly.service
    echo "Created private backup: $archive"
    ;;
  check-update)
    TAUTWEEKLY_PACKAGE_KIND=linux TAUTWEEKLY_PACKAGE_ROOT="$app_root" \
      exec /usr/local/libexec/tautweekly-package-update check
    ;;
  update)
    require_root
    TAUTWEEKLY_PACKAGE_KIND=linux TAUTWEEKLY_PACKAGE_ROOT="$app_root" \
      exec /usr/local/libexec/tautweekly-package-update apply
    ;;
  help|*)
    cat <<'EOF'
TautWeekly for Plex native Linux commands

  sudo tautweekly manager-bootstrap
  sudo tautweekly manager-reset-access
  sudo tautweekly remote-access-authorize
  sudo tautweekly remote-access-revoke
  tautweekly remote-access-status
  sudo tautweekly setup
  sudo tautweekly verify
  sudo tautweekly cache-status
  sudo tautweekly cache-refresh
  sudo tautweekly list-users
  sudo tautweekly exclude-users
  sudo tautweekly list-libraries
  sudo tautweekly manage-libraries
  sudo tautweekly preview USER_ID
  sudo tautweekly preview-all USER_ID
  sudo tautweekly send-test USER_ID
  sudo tautweekly send-test-all USER_ID
  sudo tautweekly welcome USER_ID
  sudo tautweekly send-all
  sudo tautweekly roster
  sudo tautweekly schedule-status
  sudo tautweekly schedule-enable
  sudo tautweekly schedule-disable
  sudo tautweekly schedule-reset
  sudo tautweekly status|start|stop|restart
  sudo tautweekly logs
  sudo tautweekly backup
  tautweekly check-update
  sudo tautweekly update

USER_ID is the numeric value shown by list-users. Omit it only in an
interactive terminal when you want the wrapper to prompt for it.

The authenticated Manager at http://127.0.0.1:8788 is the primary setup and
daily administration surface. Reach it through an SSH tunnel or a deliberately
configured TLS reverse proxy. These CLI commands remain recovery/expert paths.
EOF
    ;;
esac
