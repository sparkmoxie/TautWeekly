#!/bin/sh
set -eu

env_file="${TAUTWEEKLY_ENV_FILE:-/usr/local/etc/tautweekly/tautweekly.env}"
if [ ! -r "$env_file" ]; then
  echo "Settings file not found: $env_file" >&2
  exit 66
fi
# shellcheck source=/dev/null
. "$env_file"
: "${TAUTWEEKLY_CONTAINER:=tautweekly}"
: "${TAUTWEEKLY_DATA_DIR:=/var/db/tautweekly}"
: "${TAUTWEEKLY_IMAGE:=ghcr.io/sparkmoxie/tautweekly:__TAUTWEEKLY_RELEASE_VERSION__}"
podman="${TAUTWEEKLY_PODMAN_BIN:-/usr/local/bin/podman}"
lock_container_id=""

print_metadata_readiness_note()
{
  cat <<'EOF'
If this update addresses missing ratings/artwork or results still appear stale,
complete metadata readiness before testing: confirm the Plex Movie Ratings
Source; run Plex Refresh All Metadata for each included movie/TV library; then
run Tautulli Library > Media Info > Refresh media info for each same library.
EOF
}

require_root()
{
  if [ "$(id -u)" -ne 0 ]; then
    echo "Run this command as root with sudo or doas." >&2
    exit 77
  fi
}

container_exec()
{
  require_root
  if [ -t 0 ] && [ -t 1 ]; then
    "$podman" exec -it "$TAUTWEEKLY_CONTAINER" "$@"
  else
    "$podman" exec -i "$TAUTWEEKLY_CONTAINER" "$@"
  fi
}

set_funnel_adapter()
{
  require_root
  value="$1"
  [ "$value" = enabled ] || [ "$value" = disabled ] || exit 64
  temp_file="$(mktemp "${env_file}.funnel.XXXXXX")"
  trap 'rm -f "$temp_file"' EXIT HUP INT TERM
  awk -v value="$value" '
    BEGIN { found=0 }
    /^TAUTWEEKLY_FUNNEL_ADAPTER=/ {
      if (!found) print "TAUTWEEKLY_FUNNEL_ADAPTER=" value
      found=1
      next
    }
    { print }
    END { if (!found) print "TAUTWEEKLY_FUNNEL_ADAPTER=" value }
  ' "$env_file" >"$temp_file"
  chown root:wheel "$temp_file"
  chmod 0600 "$temp_file"
  mv -f "$temp_file" "$env_file"
  trap - EXIT HUP INT TERM
  TAUTWEEKLY_FUNNEL_ADAPTER="$value"
}

disable_remote_access()
{
  require_root
  if "$podman" container exists "$TAUTWEEKLY_CONTAINER" >/dev/null 2>&1; then
    running="$($podman inspect --format '{{.State.Running}}' "$TAUTWEEKLY_CONTAINER" 2>/dev/null || true)"
    if [ "$running" = true ]; then
      container_exec /opt/tautweekly/bin/tautweekly-funnel disable
    fi
  fi
}

run_mode()
{
  container_exec /opt/tautweekly/bin/run-mode.sh "$@"
}

run_script()
{
  container_exec /opt/tautweekly/bin/run-script.sh "$@"
}

prompt_user()
{
  value="${1:-}"
  if [ -z "$value" ]; then
    printf 'UserId, username, friendly name, or email: '
    read -r value
  fi
  if [ -z "$value" ]; then
    echo "A user identifier is required." >&2
    exit 64
  fi
  printf '%s' "$value"
}

confirm()
{
  printf '%s [y/N]: ' "$1"
  read -r answer
  case "$answer" in y|Y|yes|YES|Yes) return 0 ;; *) return 1 ;; esac
}

running_image_id()
{
  "$podman" inspect --format '{{.Image}}' "$TAUTWEEKLY_CONTAINER" 2>/dev/null || true
}

configured_image_id()
{
  "$podman" image inspect --format '{{.Id}}' "$TAUTWEEKLY_IMAGE" 2>/dev/null || true
}

container_instance_id()
{
  "$podman" inspect --format '{{.Id}}' "$TAUTWEEKLY_CONTAINER" 2>/dev/null || true
}

image_version()
{
  target="$1"
  if [ -z "$target" ]; then
    printf '%s' unknown
    return
  fi
  version="$("$podman" image inspect --format '{{ index .Labels "org.opencontainers.image.version" }}' "$target" 2>/dev/null || true)"
  printf '%s' "${version:-unknown}"
}

release_operation_lock()
{
  current_id="$(container_instance_id)"
  if [ -n "$lock_container_id" ] && [ "$current_id" = "$lock_container_id" ]; then
    "$podman" exec -i "$TAUTWEEKLY_CONTAINER" sh -c \
      'if [ -s /data/.tautweekly-update-holder ]; then kill "$(cat /data/.tautweekly-update-holder)" 2>/dev/null || true; fi; rm -f /data/.tautweekly-update-holder' \
      >/dev/null 2>&1 || true
  else
    "$podman" exec -i "$TAUTWEEKLY_CONTAINER" rm -f /data/.tautweekly-update-holder >/dev/null 2>&1 || true
  fi
  lock_container_id=""
}

acquire_operation_lock()
{
  "$podman" container exists "$TAUTWEEKLY_CONTAINER" >/dev/null 2>&1 || return 0
  lock_container_id="$(container_instance_id)"
  "$podman" exec -i "$TAUTWEEKLY_CONTAINER" rm -f /data/.tautweekly-update-holder >/dev/null 2>&1 || true
  "$podman" exec -d -i "$TAUTWEEKLY_CONTAINER" flock -n /data/.tautweekly-operation.lock sh -c \
    'echo $$ > /data/.tautweekly-update-holder; trap "rm -f /data/.tautweekly-update-holder" EXIT HUP INT TERM; while :; do sleep 60; done'
  attempt=1
  while [ "$attempt" -le 20 ]; do
    if "$podman" exec -i "$TAUTWEEKLY_CONTAINER" test -s /data/.tautweekly-update-holder >/dev/null 2>&1; then
      trap release_operation_lock 0
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  release_operation_lock
  echo "Another TautWeekly operation is running; the update was not started." >&2
  exit 75
}

wait_for_health()
{
  attempt=1
  while [ "$attempt" -le 60 ]; do
    running="$("$podman" inspect --format '{{.State.Running}}' "$TAUTWEEKLY_CONTAINER" 2>/dev/null || true)"
    if [ "$running" = true ] &&
        "$podman" exec -i "$TAUTWEEKLY_CONTAINER" /opt/tautweekly/healthcheck.sh >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
    attempt=$((attempt + 1))
  done
  "$podman" logs --tail 100 "$TAUTWEEKLY_CONTAINER" >&2 || true
  return 1
}

cmd="${1:-help}"
shift || true
case "$cmd" in
  setup) run_script Setup-First.ps1 ;;
  verify) run_script Verify-Setup.ps1 ;;
  cache-status) run_script Cache-Diagnostics.ps1 -DataRoot /data "$@" ;;
  cache-refresh) run_mode CacheWarm ;;
  list-users) run_mode ListUsers ;;
  exclude-users|manage-exclusions) run_script Manage-User-Exclusions.ps1 ;;
  list-libraries) run_script Manage-Library-Selection.ps1 -ListOnly ;;
  libraries|manage-libraries) run_script Manage-Library-Selection.ps1 ;;
  preview) user="$(prompt_user "${1:-}")"; run_mode Preview "$user" ;;
  preview-all) user="$(prompt_user "${1:-}")"; run_mode PreviewAll "$user" ;;
  send-test)
    user="$(prompt_user "${1:-}")"
    confirm "Send one test email to TestEmail using $user?" || exit 0
    run_mode SendTest "$user"
    ;;
  send-test-all)
    user="$(prompt_user "${1:-}")"
    confirm "Send all six regression emails to TestEmail using $user?" || exit 0
    run_mode SendTestAll "$user"
    ;;
  welcome)
    user="$(prompt_user "${1:-}")"
    confirm "Send the real one-off welcome to the selected Plex user's email?" || exit 0
    run_mode SendWelcome "$user" --confirm-welcome
    ;;
  send-all)
    echo "WARNING: This sends one real newsletter to every eligible Plex user."
    confirm "Have you reviewed a current TestEmail and do you want to continue?" || exit 0
    run_mode SendAll --confirm-send-all
    ;;
  roster) run_script View-Access-Roster.ps1 ;;
  repair-assets) run_script Repair-Assets.ps1 ;;
  manager-bootstrap)
    container_exec /opt/tautweekly/bin/run-as-user.sh \
      /opt/tautweekly/bin/tautweekly-manager access-bootstrap --data-dir /data/manager
    ;;
  manager-reset-access)
    echo "This resets only the Manager administrator password and active browser sessions."
    echo "Newsletter configuration, schedules, output, and delivery state are preserved."
    confirm "Reset Manager access and restart the rc.d service?" || exit 0
    container_exec /opt/tautweekly/bin/run-as-user.sh \
      /opt/tautweekly/bin/tautweekly-manager access-recover --data-dir /data/manager \
      --tautweekly-root /opt/tautweekly --listen 0.0.0.0:8080 --runtime-mode nas \
      --package-kind freebsd-podman --confirm
    service tautweekly restart
    echo "Run sudo tautweekly manager-bootstrap to retrieve the new one-time pairing token."
    ;;
  remote-access-authorize|remote-access-login)
    require_root
    set_funnel_adapter enabled
    service tautweekly restart
    container_exec /opt/tautweekly/bin/tautweekly-funnel login
    ;;
  remote-access-disable)
    disable_remote_access
    set_funnel_adapter disabled
    service tautweekly restart
    ;;
  schedule-status) run_script Schedule-Control.ps1 -Action Status ;;
  schedule-enable)
    confirm "Enable the configured automatic weekly send?" || exit 0
    run_script Schedule-Control.ps1 -Action Enable
    ;;
  schedule-disable) run_script Schedule-Control.ps1 -Action Disable ;;
  schedule-reset)
    echo "This clears today's automatic-attempt guard. A later scheduler poll may send again today."
    confirm "Clear the guard?" || exit 0
    run_script Schedule-Control.ps1 -Action ResetToday
    ;;
  start|restart|status)
    require_root
    service tautweekly "$cmd"
    ;;
  stop)
    disable_remote_access
    service tautweekly stop
    ;;
  logs)
    require_root
    "$podman" logs --tail 200 -f "$TAUTWEEKLY_CONTAINER"
    ;;
  shell) container_exec /opt/tautweekly/bin/run-as-user.sh /bin/bash ;;
  backup)
    require_root
    stamp="$(date +%Y%m%d-%H%M%S)"
    archive="${PWD}/tautweekly-private-data-$stamp.tar.gz"
    was_running=false
    if service tautweekly status >/dev/null 2>&1; then
      service tautweekly stop
      was_running=true
    fi
    if ! tar -czf "$archive" -C "$(dirname "$TAUTWEEKLY_DATA_DIR")" "$(basename "$TAUTWEEKLY_DATA_DIR")"; then
      $was_running && service tautweekly start
      exit 1
    fi
    chmod 600 "$archive"
    $was_running && service tautweekly start
    echo "Created private backup: $archive"
    ;;
  check-image)
    require_root
    before="$(running_image_id)"
    before_version="$(image_version "$before")"
    "$podman" pull --os=linux "$TAUTWEEKLY_IMAGE"
    after="$(configured_image_id)"
    [ -n "$after" ] || { echo "The configured image could not be inspected after pull: $TAUTWEEKLY_IMAGE" >&2; exit 69; }
    after_version="$(image_version "$after")"
    [ "$after_version" != unknown ] || { echo "The staged image has no repository version label; refusing to treat it as a release update." >&2; exit 65; }
    echo "Running image version: $before_version"
    echo "Latest configured image version: $after_version"
    if [ -z "$before" ]; then
      echo "The stable image is staged, but the TautWeekly container is not running."
    elif [ "$before" = "$after" ]; then
      echo "The running container is up to date."
    else
      echo "An update is staged. Run sudo tautweekly update to recreate the service."
    fi
    ;;
  update-image)
    require_root
    acquire_operation_lock
    before="$(running_image_id)"
    before_version="$(image_version "$before")"
    "$podman" pull --os=linux "$TAUTWEEKLY_IMAGE"
    after="$(configured_image_id)"
    [ -n "$after" ] || { echo "The configured image could not be inspected after pull: $TAUTWEEKLY_IMAGE" >&2; exit 69; }
    after_version="$(image_version "$after")"
    [ "$after_version" != unknown ] || { echo "The staged image has no repository version label; refusing to apply it." >&2; exit 65; }
    if [ -n "$before" ] && [ "$before" = "$after" ]; then
      wait_for_health
      echo "The running container is already on image version $after_version."
      print_metadata_readiness_note
      exit 0
    fi
    if service tautweekly restart && wait_for_health; then
      running_after="$(running_image_id)"
      running_after_version="$(image_version "$running_after")"
      if [ "$running_after" = "$after" ] && [ "$running_after_version" = "$after_version" ]; then
        echo "Updated TautWeekly from $before_version to $running_after_version; private data was preserved."
        print_metadata_readiness_note
        exit 0
      fi
      echo "The restarted service reports $running_after_version ($running_after), expected $after_version ($after)." >&2
    fi
    echo "The updated container failed its health check." >&2
    if [ -z "$before" ]; then
      echo "No previous running image was available for automatic rollback." >&2
      exit 70
    fi
    "$podman" tag "$before" "$TAUTWEEKLY_IMAGE"
    service tautweekly restart
    if wait_for_health && [ "$(running_image_id)" = "$before" ]; then
      echo "Rollback to image version $before_version succeeded." >&2
    else
      echo "Rollback also failed health verification. Previous image ID: $before" >&2
    fi
    exit 70
    ;;
  check-update)
    TAUTWEEKLY_PACKAGE_KIND=freebsd-podman \
      TAUTWEEKLY_PACKAGE_ROOT=/usr/local/share/tautweekly \
      exec /usr/local/libexec/tautweekly-package-update check
    ;;
  update)
    require_root
    TAUTWEEKLY_PACKAGE_KIND=freebsd-podman \
      TAUTWEEKLY_PACKAGE_ROOT=/usr/local/share/tautweekly \
      exec /usr/local/libexec/tautweekly-package-update apply
    ;;
  help|*)
    cat <<'EOF'
TautWeekly for Plex FreeBSD Podman commands

  sudo tautweekly manager-bootstrap
  sudo tautweekly manager-reset-access
  sudo tautweekly remote-access-authorize
  sudo tautweekly remote-access-disable
  sudo tautweekly setup
  sudo tautweekly verify
  sudo tautweekly cache-status
  sudo tautweekly cache-refresh
  sudo tautweekly list-users
  sudo tautweekly exclude-users
  sudo tautweekly list-libraries
  sudo tautweekly manage-libraries
  sudo tautweekly preview USER_ID
  sudo tautweekly preview-all USER_ID
  sudo tautweekly send-test USER_ID
  sudo tautweekly send-test-all USER_ID
  sudo tautweekly welcome USER_ID
  sudo tautweekly send-all
  sudo tautweekly roster
  sudo tautweekly schedule-status
  sudo tautweekly schedule-enable
  sudo tautweekly schedule-disable
  sudo tautweekly schedule-reset
  sudo tautweekly status|start|stop|restart
  sudo tautweekly logs
  sudo tautweekly backup
  sudo tautweekly check-update
  sudo tautweekly update
  sudo tautweekly shell

USER_ID is the numeric value shown by list-users. Omit it only in an
interactive terminal when you want the wrapper to prompt for it.
EOF
    ;;
esac
