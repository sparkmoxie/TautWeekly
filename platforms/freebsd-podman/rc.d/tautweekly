#!/bin/sh
# shellcheck disable=SC2034
# PROVIDE: tautweekly
# REQUIRE: NETWORKING linux podman
# KEYWORD: shutdown

. /etc/rc.subr

# rc.subr consumes these assignments dynamically.
name="tautweekly"
rcvar="tautweekly_enable"
desc="TautWeekly for Plex authenticated Manager and newsletter scheduler"
start_cmd="tautweekly_start"
stop_cmd="tautweekly_stop"
status_cmd="tautweekly_status"
restart_cmd="tautweekly_restart"

load_rc_config "$name"
: "${tautweekly_enable:=NO}"
: "${tautweekly_env:=/usr/local/etc/tautweekly/tautweekly.env}"

tautweekly_load_env()
{
    if [ ! -r "$tautweekly_env" ]; then
        echo "Required settings file is missing: $tautweekly_env" >&2
        return 1
    fi
    # The file is root-owned mode 0600 and contains only service assignments.
    # shellcheck source=/dev/null
    . "$tautweekly_env"
    : "${TAUTWEEKLY_IMAGE:=ghcr.io/sparkmoxie/tautweekly:__TAUTWEEKLY_RELEASE_VERSION__}"
    : "${TAUTWEEKLY_RUNTIME_PROFILE:=server}"
    : "${TAUTWEEKLY_CONTAINER:=tautweekly}"
    : "${TAUTWEEKLY_DATA_DIR:=/var/db/tautweekly}"
    : "${TAUTWEEKLY_TAILSCALE_STATE_DIR:=/var/db/tautweekly-tailscale}"
    : "${TAUTWEEKLY_FUNNEL_ADAPTER:=disabled}"
    : "${TAUTWEEKLY_TIMEZONE:=Etc/UTC}"
    : "${TAUTWEEKLY_PUID:=8787}"
    : "${TAUTWEEKLY_PGID:=8787}"
    : "${TAUTWEEKLY_PREVIEW_BIND:=127.0.0.1}"
    : "${TAUTWEEKLY_PREVIEW_PORT:=8787}"
    : "${TAUTWEEKLY_PREVIEW_BASE_URL:=http://127.0.0.1:8787}"
    : "${TAUTWEEKLY_MANAGER_ALLOWED_HOSTS:=}"
    : "${TAUTWEEKLY_MANAGER_SECURE_COOKIES:=false}"
    : "${TAUTWEEKLY_PODMAN_BIN:=/usr/local/bin/podman}"
    TAUTWEEKLY_PACKAGE_VERSION="$(sed -n 's/^Repository version:[[:space:]]*v\{0,1\}\([0-9][0-9A-Za-z._-]*\)$/\1/p' /usr/local/share/tautweekly/RELEASE-METADATA.txt 2>/dev/null | sed -n '1p')"
    PODMAN="$TAUTWEEKLY_PODMAN_BIN"
}

tautweekly_start()
{
    tautweekly_load_env || return 1
    if [ ! -x "$PODMAN" ]; then
        echo "Podman is not installed at $PODMAN" >&2
        return 1
    fi
    install -d -m 0700 -o "$TAUTWEEKLY_PUID" -g "$TAUTWEEKLY_PGID" "$TAUTWEEKLY_DATA_DIR"
    install -d -m 0700 -o root -g wheel "$TAUTWEEKLY_TAILSCALE_STATE_DIR"
    "$PODMAN" rm -f "$TAUTWEEKLY_CONTAINER" >/dev/null 2>&1 || true
    "$PODMAN" run --detach \
        --name "$TAUTWEEKLY_CONTAINER" \
        --os=linux \
        --pull=never \
        --stop-timeout=1800 \
        --read-only \
        --tmpfs /tmp:rw,noexec,nosuid,size=256m \
        --tmpfs /run:rw,noexec,nosuid,size=16m \
        --security-opt no-new-privileges \
        --cap-drop ALL \
        --cap-add CHOWN \
        --cap-add SETUID \
        --cap-add SETGID \
        -e "TZ=$TAUTWEEKLY_TIMEZONE" \
        -e "PUID=$TAUTWEEKLY_PUID" \
        -e "PGID=$TAUTWEEKLY_PGID" \
        -e "UMASK=077" \
        -e "TAUTWEEKLY_DATA_DIR=/data" \
        -e "TAUTWEEKLY_CONFIG=/data/config.json" \
        -e "TAUTWEEKLY_PREVIEW_BASE_URL=$TAUTWEEKLY_PREVIEW_BASE_URL" \
        -e "TAUTWEEKLY_MANAGER_RUNTIME_MODE=nas" \
        -e "TAUTWEEKLY_RUNTIME_PROFILE=$TAUTWEEKLY_RUNTIME_PROFILE" \
        -e "TAUTWEEKLY_MANAGER_LISTEN=0.0.0.0:8080" \
        -e "TAUTWEEKLY_MANAGER_ALLOWED_HOSTS=$TAUTWEEKLY_MANAGER_ALLOWED_HOSTS" \
        -e "TAUTWEEKLY_MANAGER_SECURE_COOKIES=$TAUTWEEKLY_MANAGER_SECURE_COOKIES" \
        -e "TAUTWEEKLY_FUNNEL_ADAPTER=$TAUTWEEKLY_FUNNEL_ADAPTER" \
        -e "TAUTWEEKLY_PACKAGE_KIND=freebsd-podman" \
        -e "TAUTWEEKLY_PACKAGE_VERSION=$TAUTWEEKLY_PACKAGE_VERSION" \
        -e "TAUTWEEKLY_HOST_ADAPTER_API=4" \
        -p "$TAUTWEEKLY_PREVIEW_BIND:$TAUTWEEKLY_PREVIEW_PORT:8080/tcp" \
        -v "$TAUTWEEKLY_DATA_DIR:/data:rw" \
        -v "$TAUTWEEKLY_TAILSCALE_STATE_DIR:/var/lib/tautweekly-tailscale:rw" \
        "$TAUTWEEKLY_IMAGE"
}

tautweekly_stop()
{
    tautweekly_load_env || return 1
    "$PODMAN" stop --time 1800 "$TAUTWEEKLY_CONTAINER" >/dev/null 2>&1 || true
}

tautweekly_status()
{
    tautweekly_load_env || return 1
    running="$("$PODMAN" inspect --format '{{.State.Running}}' "$TAUTWEEKLY_CONTAINER" 2>/dev/null || true)"
    if [ "$running" = "true" ]; then
        echo "TautWeekly for Plex is running in $TAUTWEEKLY_CONTAINER."
        return 0
    fi
    echo "TautWeekly for Plex is not running."
    return 1
}

tautweekly_restart()
{
    tautweekly_stop
    tautweekly_start
}

run_rc_command "$1"
