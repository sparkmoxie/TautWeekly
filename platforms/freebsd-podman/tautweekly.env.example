# Root-owned FreeBSD service settings. SMTP and API secrets stay in /var/db/tautweekly/config.json.
TAUTWEEKLY_IMAGE=ghcr.io/sparkmoxie/tautweekly:__TAUTWEEKLY_RELEASE_VERSION__
TAUTWEEKLY_RUNTIME_PROFILE=server
TAUTWEEKLY_CONTAINER=tautweekly
TAUTWEEKLY_PODMAN_BIN=/usr/local/bin/podman
TAUTWEEKLY_DATA_DIR=/var/db/tautweekly
TAUTWEEKLY_TIMEZONE=Etc/UTC
TAUTWEEKLY_PUID=8787
TAUTWEEKLY_PGID=8787
TAUTWEEKLY_PREVIEW_BIND=127.0.0.1
TAUTWEEKLY_PREVIEW_PORT=8787
TAUTWEEKLY_PREVIEW_BASE_URL=http://127.0.0.1:8787
# Add exact DNS names only when a trusted TLS reverse proxy is used.
TAUTWEEKLY_MANAGER_ALLOWED_HOSTS=
TAUTWEEKLY_MANAGER_SECURE_COOKIES=false
